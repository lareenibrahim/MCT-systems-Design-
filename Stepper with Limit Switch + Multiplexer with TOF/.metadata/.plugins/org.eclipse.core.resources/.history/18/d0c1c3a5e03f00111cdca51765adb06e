#ifndef INC_LIMIT_SWITCH_H_
#define INC_LIMIT_SWITCH_H_

#include "stm32f4xx_hal.h"
#include <stdint.h>

// ── Pin Definitions ───────────────────────────────────────────
// Adjust these to whichever free pins you wire to on your Black Pill
// Both switches wired: one terminal → GPIO pin, other terminal → GND
// Internal pull-ups are enabled; switch press pulls the line LOW

#define ARM_LIMIT_PIN           GPIO_PIN_12       // PB12
#define ARM_LIMIT_PORT          GPIOB
#define ARM_LIMIT_IRQn          EXTI15_10_IRQn    // PB12 → EXTI12 → EXTI15_10

#define GRIPPER_LIMIT_PIN       GPIO_PIN_13       // PB13
#define GRIPPER_LIMIT_PORT      GPIOB
#define GRIPPER_LIMIT_IRQn      EXTI15_10_IRQn    // PB13 → EXTI13 → same handler

// ── Homing Parameters ─────────────────────────────────────────
// For testing: reverse and travel this many steps when limit is hit
// In real homing: this is your known back-off distance
#define HOMING_BACKOFF_STEPS      400    // steps to move away after limit triggers
#define HOMING_BACKOFF_DELAY_US   500    // step speed for back-off

// ── Debounce ──────────────────────────────────────────────────
#define LIMIT_DEBOUNCE_MS         50     // ignore re-triggers within 50 ms

// ── Public Flags (read in main loop, cleared after handling) ──
extern volatile uint8_t arm_limit_triggered;    // set by ISR, cleared in main
extern volatile uint8_t gripper_cube_detected;  // set by ISR, cleared after use

// ── Init ──────────────────────────────────────────────────────
void LimitSwitch_Init(void);

// ── ISR Dispatch (call from HAL_GPIO_EXTI_Callback) ──────────
void LimitSwitch_EXTI_Callback(uint16_t GPIO_Pin);

#endif /* INC_LIMIT_SWITCH_H_ */

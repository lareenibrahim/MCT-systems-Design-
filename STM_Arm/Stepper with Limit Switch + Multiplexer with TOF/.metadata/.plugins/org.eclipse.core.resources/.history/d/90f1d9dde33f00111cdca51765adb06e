#include "stepper.h"

// ── Private State ─────────────────────────────────────────────
// volatile because these variables are written inside the ISR
// and read in the main context — without volatile the compiler
// may cache them in a register and never see the ISR's changes
static TIM_HandleTypeDef     *stepper_tim;
static volatile uint32_t      steps_remaining = 0;
static volatile uint8_t       toggle_state    = 0;
static volatile StepperState  motor_state     = STEPPER_IDLE;

// ── Init ──────────────────────────────────────────────────────
void Stepper_Init(TIM_HandleTypeDef *htim)
{
    stepper_tim = htim;

    // Safe default states on powerup
    HAL_GPIO_WritePin(STEP_PORT, STEP_PIN, GPIO_PIN_RESET); // step low
    HAL_GPIO_WritePin(DIR_PORT,  DIR_PIN,  GPIO_PIN_RESET); // default CW
    HAL_GPIO_WritePin(EN_PORT,   EN_PIN,   GPIO_PIN_SET);   // disabled (active LOW)

    motor_state = STEPPER_IDLE;
}

// ── Enable / Disable ─────────────────────────────────────────
void Stepper_Enable(void)
{
    // EN is active LOW on DRV8825
    HAL_GPIO_WritePin(EN_PORT, EN_PIN, GPIO_PIN_RESET);
    HAL_Delay(1); // short settle time after enabling
}

void Stepper_Disable(void)
{
    HAL_GPIO_WritePin(EN_PORT, EN_PIN, GPIO_PIN_SET);
}

// ── Direction ────────────────────────────────────────────────
void Stepper_SetDirection(GPIO_PinState direction)
{
    HAL_GPIO_WritePin(DIR_PORT, DIR_PIN, direction);
    // DRV8825 datasheet requires DIR to be stable
    // at least 650ns before the first step pulse
    // 1us is more than enough
    HAL_Delay(1);
}

// ── Move by steps (non-blocking) ─────────────────────────────
// step_delay_us: time between each toggle in microseconds
// one full step pulse = two toggles = step_delay_us x 2 total
//
// Speed reference at 1/8 microstepping (1600 steps/rev):
//   step_delay_us = 2000 → ~18 RPM
//   step_delay_us = 1000 → ~37 RPM
//   step_delay_us = 500  → ~75 RPM
//   step_delay_us = 200  → ~187 RPM
void Stepper_MoveSteps(uint32_t steps, uint32_t step_delay_us)
{
    if (steps == 0) return;
    if (motor_state == STEPPER_MOVING) return; // ignore if already moving

    // Each step = 2 timer interrupts (one for HIGH, one for LOW)
    steps_remaining = steps * 2;
    toggle_state    = 0;
    motor_state     = STEPPER_MOVING;

    Stepper_Enable();

    // Set timer period to fire every step_delay_us microseconds
    // Timer runs at 1MHz (prescaler=71 on 72MHz clock)
    // so 1 tick = 1us → period register = step_delay_us - 1
    __HAL_TIM_SET_AUTORELOAD(stepper_tim, step_delay_us - 1);
    __HAL_TIM_SET_COUNTER(stepper_tim, 0);

    HAL_TIM_Base_Start_IT(stepper_tim); // start, interrupts begin firing
}

// ── Move by degrees (non-blocking) ───────────────────────────
void Stepper_MoveDegs(float degrees, uint32_t step_delay_us)
{
    float    steps_per_deg = (STEPS_PER_REV_FULL * MICROSTEP_DIV) / 360.0f;
    uint32_t steps         = (uint32_t)(degrees * steps_per_deg);
    Stepper_MoveSteps(steps, step_delay_us);
}

// ── State Query ──────────────────────────────────────────────
StepperState Stepper_GetState(void)
{
    return motor_state;
}

// ── Immediate Stop (ISR-safe) ─────────────────────────────────
// Does NOT call HAL_Delay — safe to call from an interrupt context
void Stepper_Stop(void)
{
    HAL_TIM_Base_Stop_IT(stepper_tim);
    HAL_GPIO_WritePin(STEP_PORT, STEP_PIN, GPIO_PIN_RESET);
    steps_remaining = 0;
    motor_state     = STEPPER_IDLE;
}

// ── Timer ISR Callback ────────────────────────────────────────
// Called every step_delay_us from HAL_TIM_PeriodElapsedCallback
// Keep this function SHORT — no delays, no heavy logic
void Stepper_TIM_Callback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance != TIM2) return;

    if (steps_remaining == 0)
    {
        // Move complete
        HAL_TIM_Base_Stop_IT(htim);
        HAL_GPIO_WritePin(STEP_PORT, STEP_PIN, GPIO_PIN_RESET);
        motor_state = STEPPER_IDLE;
        return;
    }

    // Toggle STEP pin
    toggle_state = !toggle_state;
    HAL_GPIO_WritePin(STEP_PORT, STEP_PIN,
                      toggle_state ? GPIO_PIN_SET : GPIO_PIN_RESET);

    steps_remaining--;
}

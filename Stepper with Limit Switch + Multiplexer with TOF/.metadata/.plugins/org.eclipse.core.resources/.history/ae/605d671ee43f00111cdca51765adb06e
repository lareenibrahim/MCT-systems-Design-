#include "limit_switch.h"
#include "stepper.h"

// ── Public Flags ──────────────────────────────────────────────
volatile uint8_t arm_limit_triggered   = 0;
volatile uint8_t gripper_cube_detected = 0;

// ── Private Debounce Timestamps ───────────────────────────────
static volatile uint32_t arm_last_tick     = 0;
static volatile uint32_t gripper_last_tick = 0;

// ── Init ──────────────────────────────────────────────────────
// GPIO and NVIC are already configured by CubeMX in MX_GPIO_Init()
// This function only resets software state — safe to call anytime
void LimitSwitch_Init(void)
{
    arm_limit_triggered   = 0;
    gripper_cube_detected = 0;
    arm_last_tick         = 0;
    gripper_last_tick     = 0;
}

// ── ISR Dispatch ──────────────────────────────────────────────
// Called from HAL_GPIO_EXTI_Callback in main.c
// NO HAL_Delay, NO heavy logic — ISR context
void LimitSwitch_EXTI_Callback(uint16_t GPIO_Pin)
{
    uint32_t now = HAL_GetTick();

    if (GPIO_Pin == ARM_LIMIT_PIN)
    {
        if ((now - arm_last_tick) < LIMIT_DEBOUNCE_MS) return;
        arm_last_tick = now;

        Stepper_Stop();          // ISR-safe: no delays, just stops timer
        arm_limit_triggered = 1; // main loop handles back-off
    }
    else if (GPIO_Pin == GRIPPER_LIMIT_PIN)
    {
        if ((now - gripper_last_tick) < LIMIT_DEBOUNCE_MS) return;
        gripper_last_tick = now;

        gripper_cube_detected = 1;
    }
}

#include "limit_switch.h"
#include "stepper.h"

// ── Public Flags ──────────────────────────────────────────────
volatile uint8_t arm_limit_triggered   = 0;
volatile uint8_t gripper_cube_detected = 0;

// ── Private Debounce Timestamps ───────────────────────────────
static volatile uint32_t arm_last_tick     = 0;
static volatile uint32_t gripper_last_tick = 0;

// ── Init ──────────────────────────────────────────────────────
void LimitSwitch_Init(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    __HAL_RCC_GPIOB_CLK_ENABLE();

    // Both switches: falling edge (press pulls LOW), internal pull-up
    GPIO_InitStruct.Pin   = ARM_LIMIT_PIN | GRIPPER_LIMIT_PIN;
    GPIO_InitStruct.Mode  = GPIO_MODE_IT_FALLING;
    GPIO_InitStruct.Pull  = GPIO_PULLUP;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(GPIOB, &GPIO_InitStruct);

    // PB12 and PB13 both share the EXTI15_10 handler
    // Set limit switch priority HIGHER than the stepper timer (lower number = higher priority)
    // so it can interrupt the TIM ISR and stop the motor immediately
    HAL_NVIC_SetPriority(ARM_LIMIT_IRQn, 0, 0);
    HAL_NVIC_EnableIRQ(ARM_LIMIT_IRQn);
    // Note: GRIPPER_LIMIT_IRQn is the same line (EXTI15_10), already enabled above
}

// ── ISR Dispatch ─────────────────────────────────────────────
// Called from HAL_GPIO_EXTI_Callback in main.c
// Keep this SHORT — no HAL_Delay, no heavy logic
void LimitSwitch_EXTI_Callback(uint16_t GPIO_Pin)
{
    uint32_t now = HAL_GetTick(); // safe to read from ISR — it's just a volatile counter

    if (GPIO_Pin == ARM_LIMIT_PIN)
    {
        if ((now - arm_last_tick) < LIMIT_DEBOUNCE_MS) return; // debounce
        arm_last_tick = now;

        Stepper_Stop();          // immediately cut motor pulses (ISR-safe)
        arm_limit_triggered = 1; // signal main loop to do the back-off move
    }
    else if (GPIO_Pin == GRIPPER_LIMIT_PIN)
    {
        if ((now - gripper_last_tick) < LIMIT_DEBOUNCE_MS) return;
        gripper_last_tick = now;

        gripper_cube_detected = 1; // signal main loop that gripper is holding the cube
    }
}
